    <!-- Tempo relativo -->
    <string name="tempo_agora">agora</string>
    <string name="tempo_minutos">há %d min</string>
    <string name="tempo_horas">há %d h</string>
    <string name="tempo_dias">há %d d</string>

    <!-- Sessões -->
    <!--
        `many` é obrigatório em português desde que o CLDR passou a distinguir a
        forma de milhão ("1,5 milhão de sessões"). Aqui as três formas coincidem,
        porque o substantivo não muda — mas omitir a categoria é erro de lint, e a
        omissão viraria fallback silencioso numa contagem grande.
    -->
    <plurals name="sessoes_resumo_permissao">
        <item quantity="one">%d pedindo permissão</item>
        <item quantity="many">%d pedindo permissão</item>
        <item quantity="other">%d pedindo permissão</item>
    </plurals>
    <plurals name="sessoes_resumo_executando">
        <item quantity="one">%d executando</item>
        <item quantity="many">%d executando</item>
        <item quantity="other">%d executando</item>
    </plurals>
