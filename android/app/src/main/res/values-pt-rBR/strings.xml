    <string name="app_name">Lume</string>

    <!-- Barra inferior -->
    <string name="nav_sessoes">Sessões</string>
    <string name="nav_historico">Histórico</string>
    <string name="nav_ajustes">Ajustes</string>

    <!-- Estado da conexão -->
    <string name="conexao_conectado">Conectado</string>
    <string name="conexao_conectando">Conectando</string>
    <string name="conexao_sem">Sem conexão</string>
    <string name="conexao_faixa_offline">Sem conexão com %1$s · mostrando o último estado conhecido</string>
    <string name="conexao_ultimo_estado">Último estado conhecido · %1$s</string>

    <!-- Estado da sessão -->
    <string name="estado_executando">Executando</string>
