<?xml version="1.0" encoding="utf-8"?>
<!--
    Idêntico ao `ic_launcher.xml`, e é assim que deve ser: num ícone adaptativo
    quem decide o recorte é a máscara do lançador, não este arquivo. As duas
    entradas existem porque o manifest declara `icon` e `roundIcon`, e lançadores
    antigos leem a segunda.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
