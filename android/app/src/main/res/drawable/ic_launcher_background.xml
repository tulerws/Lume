<?xml version="1.0" encoding="utf-8"?>
<!--
    Camada de fundo do ícone adaptativo: cor sólida da marca.

    O `static/lume.svg` traz o próprio fundo, um retângulo arredondado de raio
    112. Isso conflita com o ícone adaptativo, que recorta a máscara ele mesmo e
    de forma diferente em cada fabricante: o retângulo do SVG apareceria recortado
    por dentro do círculo, com uma borda escura sobrando. Por isso o fundo virou
    esta camada e o glifo ficou sozinho na camada da frente.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="@color/lume_brand_background"
        android:pathData="M0,0h108v108h-108z" />
</vector>
